<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.ibm.odm.tools</groupId>
  <artifactId>configure-dt</artifactId>
  <version>9.5.0</version>
 <properties>
 	<odm.version>9.5.0.0</odm.version>
 	<odm.lib.path>C:/Tools/IBM/ODM9.5.0.0/teamserver/lib</odm.lib.path>
 	<odm.eclipse.path>C:/Tools/IBM/ODM9.5.0.0/teamserver/lib/eclipse_plugins</odm.eclipse.path>
 	<repositoryId>dec-snapshots</repositoryId>
 	<repositoryUrl>https://eu.artifactory.swg-devops.com:443/artifactory/hyc-ai-tribe-l3-team-odm-release-maven-local</repositoryUrl>
 </properties>

	<distributionManagement>
		<snapshotRepository>
			<id>${repositoryId}</id>
			<url>${repositoryUrl}</url>
		</snapshotRepository>
	</distributionManagement>
	
 <dependencies>
    <!-- ODM JRules Core Libraries -->
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-teamserver</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-teamserver.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-engine</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-engine.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-res-tools</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-res-tools.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-ruleartifacts</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-ruleartifacts.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-synchronization</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-synchronization.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-validation</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-validation.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-language</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-language.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-services</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-services.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-decisionservice</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-decisionservice.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-decisionservice-model</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-decisionservice-model.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-dataaccess-rs4j</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-dataaccess-rs4j.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-common-rs4jutils</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-common-rs4jutils.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-model-dataaccess</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-model-dataaccess.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>jrules-model-xml</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jrules-model-xml.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm.odm</groupId>
        <artifactId>bdsl-dtx-core</artifactId>
        <version>${odm.version}</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/bdsl-dtx-core.jar</systemPath>
    </dependency>
    
    <!-- Eclipse EMF Libraries -->
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.common</artifactId>
        <version>2.31.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.common_2.31.0.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.ecore</artifactId>
        <version>2.37.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.ecore_2.37.0.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.ecore-xmi</artifactId>
        <version>2.16.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.ecore-xmi_2.16.0.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.edit</artifactId>
        <version>2.23.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.edit_2.23.0.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.mapping</artifactId>
        <version>2.12.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.mapping_2.12.0.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>org.eclipse.emf</groupId>
        <artifactId>org.eclipse.emf.mapping-ecore2ecore</artifactId>
        <version>2.11.0</version>
        <scope>system</scope>
        <systemPath>${odm.eclipse.path}/org.eclipse.emf.mapping-ecore2ecore_2.11.0.jar</systemPath>
    </dependency>
    
    <!-- Supporting Libraries -->
    <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>2.1.1</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/jakarta.annotation-api-2.1.1.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm</groupId>
        <artifactId>xalan</artifactId>
        <version>2.7.3.IBM</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/xalan-2.7.3.IBM.jar</systemPath>
    </dependency>
    <dependency>
        <groupId>com.ibm</groupId>
        <artifactId>serializer</artifactId>
        <version>2.7.3.IBM</version>
        <scope>system</scope>
        <systemPath>${odm.lib.path}/serializer-2.7.3.IBM.jar</systemPath>
    </dependency>
</dependencies>    
  <build>
   	<sourceDirectory>src/java</sourceDirectory>
	<resources>
		<resource>
			<directory>src/java</directory>
			<excludes>
				<exclude>**/*.java</exclude>
			</excludes>
		</resource>
		<resource>
			<directory>src/resources</directory>
			<excludes>
				<exclude>**/*.java</exclude>
			</excludes>
		</resource>
	</resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
            <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <phase>verify</phase>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

